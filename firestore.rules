rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Rooms are 4-char codes. Anyone authed can read so a joiner can
    // check existence. Writes are gated to room participants only, and
    // each write path may only touch the fields that flow actually uses.
    match /rooms/{code} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isParticipant(data) {
        return request.auth.uid == data.hostId
            || request.auth.uid == data.guestId;
      }
      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      function myPresenceField(data) {
        return request.auth.uid == data.hostId ? 'hostPresent' : 'guestPresent';
      }

      allow read: if isSignedIn();

      // Create: caller must claim the host seat themselves.
      allow create: if isSignedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.guestId == null
        && request.resource.data.code == code
        && request.resource.data.expiresAt is timestamp;

      // Update paths, each limited to exactly the fields that flow writes
      // (hostId, code, createdAt, expiresAt are therefore immutable):
      //  1. Guest joining: claim an empty guest seat with your own uid.
      //  2. Participant toggling their own presence flag.
      //  3. Participant clearing the guest seat (leave).
      allow update: if isSignedIn()
        && (
          (resource.data.guestId == null
            && request.resource.data.guestId == request.auth.uid
            && changedKeys().hasOnly(['guestId', 'guestPresent']))
          || (isParticipant(resource.data)
            && changedKeys().hasOnly([myPresenceField(resource.data)]))
          || (isParticipant(resource.data)
            && request.resource.data.guestId == null
            && changedKeys().hasOnly(['guestId', 'guestPresent']))
        );

      // Delete: only host can wipe the room.
      allow delete: if isSignedIn() && resource.data.hostId == request.auth.uid;

      // Per-room game state. Single doc at `state/current` holds the
      // authoritative GameState. Only the participant whose turn it is
      // may write — we check by reading the parent room for the seat
      // mapping and the doc itself for `turn`.
      match /state/{stateId} {
        function room() {
          return get(/databases/$(database)/documents/rooms/$(code)).data;
        }
        function callerSeat() {
          return request.auth.uid == room().hostId ? 'host'
               : request.auth.uid == room().guestId ? 'guest'
               : null;
        }

        allow read: if isSignedIn() && isParticipant(room());

        // Only the host writes the initial state, and only once.
        allow create: if isSignedIn()
          && request.auth.uid == room().hostId
          && request.resource.data.turn in ['host', 'guest'];

        // Moves must come from whoever's turn it currently is, and must
        // advance the monotonic tick (no replaying or rewinding state).
        // After the round ends (winner != null) only the host may write —
        // that's the "deal a new round" reset, which starts back at tick 0.
        allow update: if isSignedIn()
          && isParticipant(room())
          && (
            (resource.data.winner != null
              && request.auth.uid == room().hostId)
            || (resource.data.turn == callerSeat()
              && request.resource.data.tick > resource.data.tick)
          );
      }

      // Append-only move log. Used for replay, debugging, and lets
      // clients reconcile when they reconnect mid-game.
      match /moves/{seq} {
        function room() {
          return get(/databases/$(database)/documents/rooms/$(code)).data;
        }
        allow read: if isSignedIn() && isParticipant(room());
        allow create: if isSignedIn()
          && isParticipant(room())
          && request.resource.data.actor == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
