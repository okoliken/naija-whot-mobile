{
  "expo": {
    "name": "whot",
    "slug": "whot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/whot-icon.png",
    "scheme": "whot",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.okolijeff.whot",
      "icon": "./assets/app-icon.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF4E6",
        "foregroundImage": "./assets/images/whot-android-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.okolijeff.whot"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f0e71184-2ef2-459e-b2ad-b4a1e210582b"
      }
    }
  }
}
